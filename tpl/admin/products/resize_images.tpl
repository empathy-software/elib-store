
<fieldset>
    <legend>Resize Images</legend>
    <form action="" method="post">
        <div class="mb-3">
            <label class="form-label">Thumb Max Width</label>
            <input class="form-control" type="text" value="" name="tn_width"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Thumb Max Height</label>
            <input class="form-control" type="text" value="" name="tn_height"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Mid Max Width</label>
            <input class="form-control" type="text" value="" name="mid_width"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Mid Max Height</label>
            <input class="form-control" type="text" value="" name="mid_height"/>
        </div>
        <div class="mb-3">
            <button class="btn btn-sm btn-primary" type="submit" name="submit">Submit</button>
        </div>
    </form>
</fieldset>


