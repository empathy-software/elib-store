{
    "name": "mikejw/elib-store",
    "type": "library",
    "description": "ELib Store",
    "keywords": [
        "lib"
    ],
    "homepage": "http://empathy.sh",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael J. Whiting",
            "email": "mail@mikejw.co.uk"
        }
    ],
    "require": {
        "mikejw/elib-base": "^4"
    },
    "autoload": {
        "psr-0": {
            "Empathy": "src/"
        }
    },
    "minimum-stability": "dev",
    "require-dev": {
        "laravel/pint": "dev-main"
    },
    "scripts": {
        "format": "pint ./src",
        "format-check": "pint --test ./src",
        "analyse": "phpstan --memory-limit=1G"
    }
}
